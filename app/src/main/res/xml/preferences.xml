<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Downloads" app:iconSpaceReserved="false">
        <ListPreference
            app:defaultValue="720"
            app:entries="@array/quality_labels"
            app:entryValues="@array/quality_values"
            app:iconSpaceReserved="false"
            app:key="default_quality"
            app:title="Default quality"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:defaultValue="1"
            app:entries="@array/parallel_labels"
            app:entryValues="@array/parallel_values"
            app:iconSpaceReserved="false"
            app:key="parallel"
            app:title="Download at the same time"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="wifi_only"
            app:summary="Wait for Wi-Fi instead of using mobile data"
            app:title="Wi-Fi only" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="allow_webm"
            app:summary="1440p and 4K come as WebM (VP9). Off = MP4 only, up to 1080p"
            app:title="Allow 1440p / 4K" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Audio" app:iconSpaceReserved="false">
        <ListPreference
            app:defaultValue="m4a"
            app:entries="@array/audio_format_labels"
            app:entryValues="@array/audio_format_values"
            app:iconSpaceReserved="false"
            app:key="audio_format"
            app:title="Audio-only format"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Player" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="autoplay_next"
            app:summary="When a file finishes, play the next one in the list"
            app:title="Autoplay next" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Search" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="clipboard_prompt"
            app:summary="When you open the app after copying a YouTube link, offer to open it"
            app:title="Detect copied links" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="search_history"
            app:summary="Suggest your recent searches"
            app:title="Remember searches" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="clear_history"
            app:title="Clear search history" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Extras" app:iconSpaceReserved="false">
        <ListPreference
            app:defaultValue=""
            app:entries="@array/subtitle_labels"
            app:entryValues="@array/subtitle_values"
            app:iconSpaceReserved="false"
            app:key="subtitle_lang"
            app:title="Save subtitles (.srt)"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="sponsorblock"
            app:summary="Cut out sponsor, self-promo, intro and outro segments (SponsorBlock)"
            app:title="Remove sponsor segments" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="auto_sync"
            app:summary="Every night, queue new videos from your synced playlists and channels"
            app:title="Auto-sync playlists" />
    </PreferenceCategory>

    <PreferenceCategory app:title="App" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="update_check"
            app:summary="Look for a new version when the app opens"
            app:title="Check for updates automatically" />
    </PreferenceCategory>
</PreferenceScreen>
